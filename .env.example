# Inbox Intel Environment Variables

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Your Google Cloud Console OAuth2 credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Redirect URI — must match the one configured in Google Cloud Console
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Paths ────────────────────────────────────────────────────────────────────
# Path to the SQLite database
# DB_PATH=~/.inbox-intel/emails.db

# Path to the Gmail OAuth2 token (generated after first login)
# TOKEN_PATH=~/.inbox-intel/token.json

# Path to your Google OAuth2 credentials file (downloaded from Google Cloud Console)
# CREDENTIALS_PATH=~/.inbox-intel/credentials.json

# ── Ollama Configuration ─────────────────────────────────────────────────────
# URL where your local Ollama instance is running
# OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model to use for classification
# OLLAMA_MODEL=llama3

# Timeout for Ollama requests in seconds
# OLLAMA_TIMEOUT=60

# ── App Configuration ────────────────────────────────────────────────────────
# Maximum number of emails to fetch and process in a single run
# MAX_EMAILS_PER_RUN=200

# Number of times to retry classification if it fails to produce valid JSON
# CLASSIFICATION_RETRIES=3

# ── Security (Optional) ─────────────────────────────────────────────────────
# Set a Fernet key to encrypt OAuth tokens at rest.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to store tokens as plain JSON (backward compatible).
# TOKEN_ENCRYPTION_KEY=

# ── JWT Authentication ───────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Auto-generated if not set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=your-jwt-secret-key
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=1440

# ── SSL / HTTPS (optional) ──────────────────────────────────────────────────
# Paths to SSL key and certificate for HTTPS in development.
# Generate with: bash scripts/generate_certs.sh
# SSL_KEYFILE=./.inbox-intel/certs/key.pem
# SSL_CERTFILE=./.inbox-intel/certs/cert.pem

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
