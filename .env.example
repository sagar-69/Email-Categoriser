# Inbox Intel Environment Variables

# ── Paths ────────────────────────────────────────────────────────────────────
# Path to the SQLite database
# DB_PATH=~/.inbox-intel/emails.db

# Path to the Gmail OAuth2 token (generated after first login)
# TOKEN_PATH=~/.inbox-intel/token.json

# Path to your Google OAuth2 credentials file (downloaded from Google Cloud Console)
# CREDENTIALS_PATH=~/.inbox-intel/credentials.json

# ── Ollama Configuration ─────────────────────────────────────────────────────
# URL where your local Ollama instance is running
# OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model to use for classification
# OLLAMA_MODEL=llama3

# Timeout for Ollama requests in seconds
# OLLAMA_TIMEOUT=60

# ── App Configuration ────────────────────────────────────────────────────────
# Maximum number of emails to fetch and process in a single run
# MAX_EMAILS_PER_RUN=200

# Number of times to retry classification if it fails to produce valid JSON
# CLASSIFICATION_RETRIES=3
